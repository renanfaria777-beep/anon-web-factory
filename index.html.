
<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#101010">
<title>ANON WEB FACTORY</title>
<style>
:root{--bg:#101010;--panel:#191919;--gold:#d6ad55;--text:#f5f5f5;--muted:#999;--line:#303030}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--text);font-family:Arial,sans-serif}
header{padding:20px;background:#151515;border-bottom:1px solid var(--line);display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap}
.logo{font-size:21px;font-weight:900;letter-spacing:1px}.logo span{color:var(--gold)}
header small{color:var(--muted)}
nav{display:flex;gap:7px;padding:12px;overflow-x:auto;background:#141414;border-bottom:1px solid var(--line)}
nav button{white-space:nowrap;background:#222;color:#ddd;border:1px solid #333;padding:11px 14px;border-radius:8px;cursor:pointer}
nav button.active,button.primary{background:var(--gold);color:#111;border-color:var(--gold);font-weight:bold}
main{max-width:1200px;margin:auto;padding:18px}
section.page{display:none}section.page.active{display:block}
h1{font-size:25px;margin:10px 0 5px}h2{font-size:19px}
.subtitle{color:var(--muted);margin-bottom:22px}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:14px}
.card{background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:18px;margin-bottom:14px}
.stat{font-size:30px;color:var(--gold);font-weight:bold;margin-top:10px}
label{display:block;font-size:13px;color:#ccc;margin:13px 0 6px}
input,textarea,select{width:100%;padding:12px;background:#101010;border:1px solid #393939;color:white;border-radius:8px;font:inherit}
textarea{min-height:90px;resize:vertical}
button{padding:11px 15px;border:1px solid #444;border-radius:8px;background:#252525;color:white;cursor:pointer;font-weight:bold}
button:hover{filter:brightness(1.15)}
.actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:14px}
.item{padding:13px;border-bottom:1px solid var(--line);display:flex;justify-content:space-between;gap:10px;align-items:center}
.item:last-child{border:0}
.muted{color:var(--muted);font-size:13px}
#preview{width:100%;height:650px;border:1px solid #444;border-radius:10px;background:white}
.notice{background:#292317;border:1px solid #66532b;color:#f2d99f;padding:12px;border-radius:8px;font-size:13px;margin:12px 0}
footer{text-align:center;color:#666;padding:25px;font-size:12px}
@media(max-width:600px){header{align-items:flex-start}main{padding:12px}.card{padding:14px}#preview{height:520px}}
</style>
</head>
<body>

<header>
  <div>
    <div class="logo">ANON <span>WEB FACTORY</span></div>
    <small>Seu centro de criação e gestão digital</small>
  </div>
  <small id="today"></small>
</header>

<nav>
  <button class="active" data-page="home">Visão geral</button>
  <button data-page="leads">Prospecção</button>
  <button data-page="clients">Clientes</button>
  <button data-page="projects">Projetos</button>
  <button data-page="studio">Criador de sites</button>
</nav>

<main>

<section id="home" class="page active">
  <h1>Visão geral</h1>
  <p class="subtitle">Bem-vindo à sua central de negócios.</p>
  <div class="grid">
    <div class="card">Empresas prospectadas<div class="stat" id="countLeads">0</div></div>
    <div class="card">Clientes cadastrados<div class="stat" id="countClients">0</div></div>
    <div class="card">Projetos registrados<div class="stat" id="countProjects">0</div></div>
  </div>
  <div class="card">
    <h2>Comece por aqui</h2>
    <p class="muted">Cadastre empresas, acompanhe clientes e crie sites profissionais para apresentar seus projetos.</p>
    <div class="actions">
      <button class="primary" onclick="showPage('studio')">Criar um site</button>
      <button onclick="showPage('leads')">Adicionar empresa</button>
    </div>
  </div>
</section>

<section id="leads" class="page">
  <h1>Prospecção</h1>
  <p class="subtitle">Organize empresas que podem precisar de um site.</p>
  <div class="card">
    <h2>Nova empresa</h2>
    <label>Nome da empresa</label>
    <input id="leadName" placeholder="Ex.: Studio Beleza">
    <label>WhatsApp</label>
    <input id="leadPhone" placeholder="Ex.: 5512999999999">
    <label>Observações</label>
    <textarea id="leadNote" placeholder="Informações sobre a empresa"></textarea>
    <button class="primary" onclick="addLead()">Salvar empresa</button>
  </div>
  <div class="card"><h2>Empresas cadastradas</h2><div id="leadList"></div></div>
</section>

<section id="clients" class="page">
  <h1>Clientes</h1>
  <p class="subtitle">Mantenha seus contatos organizados.</p>
  <div class="card">
    <label>Nome do cliente</label>
    <input id="clientName" placeholder="Nome">
    <label>Contato</label>
    <input id="clientPhone" placeholder="WhatsApp ou telefone">
    <button class="primary" onclick="addClient()">Cadastrar cliente</button>
  </div>
  <div class="card"><h2>Lista de clientes</h2><div id="clientList"></div></div>
</section>

<section id="projects" class="page">
  <h1>Projetos</h1>
  <p class="subtitle">Acompanhe seus trabalhos.</p>
  <div class="card">
    <label>Nome do projeto</label>
    <input id="projectName" placeholder="Ex.: Site da empresa">
    <label>Status</label>
    <select id="projectStatus">
      <option>Em andamento</option>
      <option>Em aprovação</option>
      <option>Concluído</option>
    </select>
    <button class="primary" onclick="addProject()">Adicionar projeto</button>
  </div>
  <div class="card"><h2>Seus projetos</h2><div id="projectList"></div></div>
</section>

<section id="studio" class="page">
  <h1>Criador de Sites</h1>
  <p class="subtitle">Preencha os dados e gere um site pronto para visualizar, copiar e publicar.</p>

  <div class="notice">O gerador cria páginas HTML automaticamente a partir das informações preenchidas. Não precisa escrever código.</div>

  <div class="card">
    <h2>1. Informações do negócio</h2>
    <label>Nome da empresa</label>
    <input id="siteName" placeholder="Ex.: Studio Débora Sulamita">
    <label>Ramo de atividade</label>
    <input id="siteCategory" placeholder="Ex.: Salão de beleza, oficina, restaurante">
    <label>Descrição da empresa</label>
    <textarea id="siteDescription" placeholder="Conte o que a empresa oferece e seus diferenciais"></textarea>
    <label>Endereço</label>
    <input id="siteAddress" placeholder="Cidade, bairro ou endereço">
    <label>WhatsApp com DDD</label>
    <input id="sitePhone" placeholder="Ex.: 5512999999999">
    <label>Instagram (opcional)</label>
    <input id="siteInstagram" placeholder="https://instagram.com/empresa">
    <label>Serviços ou produtos</label>
    <textarea id="siteServices" placeholder="Ex.: Cortes, coloração, hidratação. Separe por vírgulas."></textarea>
  </div>

  <div class="card">
    <h2>2. Personalização</h2>
    <label>Estilo visual</label>
    <select id="siteStyle">
      <option value="modern">Moderno e elegante</option>
      <option value="luxury">Luxuoso e sofisticado</option>
      <option value="minimal">Minimalista</option>
      <option value="bold">Moderno e marcante</option>
    </select>
    <label>Cor principal</label>
    <input type="color" id="siteColor" value="#b68a45">
    <label>Texto do botão principal</label>
    <input id="siteButton" value="Fale conosco pelo WhatsApp">
    <div class="actions">
      <button class="primary" onclick="generateSite()">GERAR MEU SITE</button>
      <button onclick="clearSiteForm()">Limpar formulário</button>
    </div>
  </div>

  <div class="card">
    <h2>3. Visualização do site</h2>
    <p class="muted">Depois de gerar, confira o resultado abaixo.</p>
    <iframe id="preview" title="Prévia do site"></iframe>
    <div class="actions">
      <button class="primary" onclick="copySite()">COPIAR CÓDIGO HTML</button>
      <button onclick="downloadSite()">BAIXAR SITE HTML</button>
    </div>
    <p class="muted" id="siteMessage">Seu site aparecerá aqui depois de clicar em Gerar meu site.</p>
  </div>
</section>

</main>

<footer>ANON WEB FACTORY • Central de criação digital</footer>

<script>
const KEY = "anon_web_factory_complete_v1";

let data = {leads:[],clients:[],projects:[]};
let generatedHTML = "";

try {
  const saved = localStorage.getItem(KEY);
  if(saved) data = {...data,...JSON.parse(saved)};
} catch(e) {}

function saveData(){
  localStorage.setItem(KEY,JSON.stringify(data));
  updateDashboard();
}

function showPage(id){
  document.querySelectorAll(".page").forEach(p=>p.classList.remove("active"));
  document.querySelectorAll("nav button").forEach(b=>b.classList.remove("active"));
  document.getElementById(id).classList.add("active");
  document.querySelector('[data-page="'+id+'"]').classList.add("active");
}

document.querySelectorAll("nav button").forEach(btn=>{
  btn.addEventListener("click",()=>showPage(btn.dataset.page));
});

function safe(value){
  return String(value||"").replace(/[&<>"']/g,char=>({
    "&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"
  }[char]));
}

function addLead(){
  const name=document.getElementById("leadName").value.trim();
  if(!name){alert("Digite o nome da empresa.");return;}
  data.leads.push({
    name,
    phone:document.getElementById("leadPhone").value.trim(),
    note:document.getElementById("leadNote").value.trim()
  });
  ["leadName","leadPhone","leadNote"].forEach(id=>document.getElementById(id).value="");
  saveData();renderLists();
}

function addClient(){
  const name=document.getElementById("clientName").value.trim();
  if(!name){alert("Digite o nome do cliente.");return;}
  data.clients.push({name,phone:document.getElementById("clientPhone").value.trim()});
  document.getElementById("clientName").value="";
  document.getElementById("clientPhone").value="";
  saveData();renderLists();
}

function addProject(){
  const name=document.getElementById("projectName").value.trim();
  if(!name){alert("Digite o nome do projeto.");return;}
  data.projects.push({name,status:document.getElementById("projectStatus").value});
  document.getElementById("projectName").value="";
  saveData();renderLists();
}

function removeItem(type,index){
  if(!confirm("Deseja excluir este registro?"))return;
  data[type].splice(index,1);
  saveData();renderLists();
}

function renderLists(){
  document.getElementById("leadList").innerHTML=data.leads.map((x,i)=>`
    <div class="item"><div><b>${safe(x.name)}</b><div class="muted">${safe(x.phone)} ${safe(x.note)}</div></div>
    <button onclick="removeItem('leads',${i})">Excluir</button></div>`).join("")||'<p class="muted">Nenhuma empresa cadastrada.</p>';

  document.getElementById("clientList").innerHTML=data.clients.map((x,i)=>`
    <div class="item"><div><b>${safe(x.name)}</b><div class="muted">${safe(x.phone)}</div></div>
    <button onclick="removeItem('clients',${i})">Excluir</button></div>`).join("")||'<p class="muted">Nenhum cliente cadastrado.</p>';

  document.getElementById("projectList").innerHTML=data.projects.map((x,i)=>`
    <div class="item"><div><b>${safe(x.name)}</b><div class="muted">${safe(x.status)}</div></div>
    <button onclick="removeItem('projects',${i})">Excluir</button></div>`).join("")||'<p class="muted">Nenhum projeto cadastrado.</p>';
}

function updateDashboard(){
  document.getElementById("countLeads").textContent=data.leads.length;
  document.getElementById("countClients").textContent=data.clients.length;
  document.getElementById("countProjects").textContent=data.projects.length;
}

function generateSite(){
  const name=document.getElementById("siteName").value.trim();
  const category=document.getElementById("siteCategory").value.trim();
  const description=document.getElementById("siteDescription").value.trim();
  const address=document.getElementById("siteAddress").value.trim();
  const phoneRaw=document.getElementById("sitePhone").value.trim();
  const instagram=document.getElementById("siteInstagram").value.trim();
  const servicesRaw=document.getElementById("siteServices").value.trim();
  const style=document.getElementById("siteStyle").value;
  const color=document.getElementById("siteColor").value;
  const buttonText=document.getElementById("siteButton").value.trim()||"Fale conosco";

  if(!name||!category||!description){
    alert("Preencha pelo menos o nome, o ramo e a descrição da empresa.");
    return;
  }

  let phone=phoneRaw.replace(/\D/g,"");
  if(phone && phone.length>=10 && !phone.startsWith("55"))phone="55"+phone;

  const whatsapp=phone.length>=12
    ? "https://wa.me/"+phone
    : "#contato";

  const services=servicesRaw.split(",").map(s=>s.trim()).filter(Boolean);
  const serviceHTML=services.length
    ? services.map(s=>`<article class="service"><h3>${safe(s)}</h3><p>Entre em contato para saber mais sobre este serviço.</p></article>`).join("")
    : `<article class="service"><h3>Nossos serviços</h3><p>Entre em contato para conhecer nossas soluções.</p></article>`;

  const backgrounds={
    modern:"#111827",
    luxury:"#17130f",
    minimal:"#f5f5f5",
    bold:"#151515"
  };
  const textColor=style==="minimal"?"#222":"#fff";
  const muted=style==="minimal"?"#555":"#c7c7c7";

  generatedHTML=`<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="description" content="${safe(description)}">
<title>${safe(name)} | ${safe(category)}</title>
<style>
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;font-family:Arial,sans-serif;background:${backgrounds[style]};color:${textColor}}
header{padding:22px 7%;display:flex;justify-content:space-between;align-items:center;gap:15px;flex-wrap:wrap;border-bottom:1px solid #7773}
.logo{font-size:23px;font-weight:900}
nav a{color:inherit;text-decoration:none;margin-left:18px;font-size:14px}
.hero{min-height:520px;padding:100px 8%;display:flex;flex-direction:column;justify-content:center;background:linear-gradient(120deg,${backgrounds[style]},${color}66)}
.tag{color:${color};font-weight:bold;text-transform:uppercase;letter-spacing:3px}
h1{font-size:clamp(38px,7vw,72px);max-width:850px;line-height:1.05;margin:18px 0}
.hero p{max-width:650px;color:${muted};font-size:18px;line-height:1.7}
.btn{display:inline-block;background:${color};color:#fff;padding:16px 24px;border-radius:7px;text-decoration:none;font-weight:bold;margin-top:18px}
section{padding:75px 8%}
section h2{font-size:34px;margin-top:0}
.intro{max-width:750px;color:${muted};line-height:1.8}
.services{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:18px;margin-top:30px}
.service{padding:25px;border:1px solid #8885;border-radius:12px;background:${color}13}
.service h3{margin-top:0}
.service p{color:${muted};line-height:1.6}
.contact{background:${color}18;text-align:center}
.contact p{color:${muted};line-height:1.8}
footer{text-align:center;padding:25px;color:${muted};border-top:1px solid #8884}
@media(max-width:600px){header{padding:18px 5%}nav a{margin-left:8px;font-size:12px}.hero{padding:75px 6%}section{padding:55px 6%}}
</style>
</head>
<body>
<header>
<div class="logo">${safe(name)}</div>
<nav><a href="#inicio">Início</a><a href="#sobre">Sobre</a><a href="#servicos">Serviços</a><a href="#contato">Contato</a></nav>
</header>
<main>
<section class="hero" id="inicio">
<div class="tag">${safe(category)}</div>
<h1>${safe(name)}</h1>
<p>${safe(description)}</p>
<a class="btn" href="${whatsapp}">${safe(buttonText)}</a>
</section>
<section id="sobre">
<h2>Conheça a ${safe(name)}</h2>
<p class="intro">${safe(description)}</p>
${address?`<p class="intro"><b>Localização:</b> ${safe(address)}</p>`:""}
</section>
<section id="servicos">
<h2>O que oferecemos</h2>
<p class="intro">Conheça algumas das nossas soluções e entre em contato para saber mais.</p>
<div class="services">${serviceHTML}</div>
</section>
<section class="contact" id="contato">
<h2>Vamos conversar?</h2>
<p>Entre em contato com a nossa equipe. Será um prazer atender você.</p>
<a class="btn" href="${whatsapp}">${safe(buttonText)}</a>
${instagram?`<p><a style="color:${color}" href="${safe(instagram)}" target="_blank" rel="noopener">Acompanhe nosso Instagram</a></p>`:""}
${address?`<p>${safe(address)}</p>`:""}
</section>
</main>
<footer>© ${new Date().getFullYear()} ${safe(name)}. Todos os direitos reservados.</footer>
</body>
</html>`;

  document.getElementById("preview").srcdoc=generatedHTML;
  document.getElementById("siteMessage").textContent="Site gerado! Confira a prévia e copie ou baixe o HTML.";
  document.getElementById("preview").scrollIntoView({behavior:"smooth",block:"start"});
}

async function copySite(){
  if(!generatedHTML){alert("Gere um site primeiro.");return;}
  try{
    await navigator.clipboard.writeText(generatedHTML);
    alert("Código HTML copiado!");
  }catch(e){
    const area=document.createElement("textarea");
    area.value=generatedHTML;
    document.body.appendChild(area);
    area.select();
    const ok=document.execCommand("copy");
    area.remove();
    alert(ok?"Código HTML copiado!":"Não foi possível copiar. Tente baixar o arquivo.");
  }
}

function downloadSite(){
  if(!generatedHTML){alert("Gere um site primeiro.");return;}
  const blob=new Blob([generatedHTML],{type:"text/html;charset=utf-8"});
  const url=URL.createObjectURL(blob);
  const a=document.createElement("a");
  a.href=url;
  a.download="site-gerado.html";
  document.body.appendChild(a);
  a.click();
  a.remove();
  URL.revokeObjectURL(url);
}

function clearSiteForm(){
  ["siteName","siteCategory","siteDescription","siteAddress","sitePhone","siteInstagram","siteServices"].forEach(id=>document.getElementById(id).value="");
  document.getElementById("siteStyle").value="modern";
  document.getElementById("siteColor").value="#b68a45";
  document.getElementById("siteButton").value="Fale conosco pelo WhatsApp";
}

document.getElementById("today").textContent=new Date().toLocaleDateString("pt-BR");
renderLists();
updateDashboard();
</script>
</body>
</html>
